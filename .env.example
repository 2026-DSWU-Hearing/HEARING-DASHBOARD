# 백엔드 API 베이스 URL. 미설정 시 배포 서버 https://hearing-api.duckdns.org 사용
# 로컬 백엔드로 테스트할 때만 http://localhost:8000 지정. WebSocket 은 이 주소의 http → ws(s) 치환으로 자동 파생
VITE_API_BASE_URL=

# 구글 로그인 클라이언트 ID (백엔드 GOOGLE_CLIENT_ID 와 동일해야 함). 미설정 시 코드 기본값 사용
VITE_GOOGLE_CLIENT_ID=

# 대시보드 흉상 GLB 경로 (미설정 시 /models/mannequin.glb)
VITE_MANNEQUIN_MODEL_URL=
